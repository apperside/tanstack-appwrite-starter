# Backend adapter: "appwrite" (default) or "memory" (in-process, for development; no Appwrite variables needed) (server only)
BACKEND=
# Appwrite endpoint URL (public; BACKEND=appwrite)
VITE_APPWRITE_ENDPOINT=
# Appwrite project ID (public; BACKEND=appwrite)
VITE_APPWRITE_PROJECT_ID=
# Appwrite database ID (public; BACKEND=appwrite); "app" matches appwrite.json
VITE_APPWRITE_DATABASE_ID=
# "true" keeps unverified users on /verify-email until they verify; they can still sign in (public)
VITE_REQUIRE_EMAIL_VERIFICATION=
# Appwrite server API key (secret, server only; BACKEND=appwrite)
APPWRITE_API_KEY=
# Public base URL of this app; https names the session cookie __Host-app_session (server only)
APP_URL=
# Number of reverse proxies in front of the app that append to X-Forwarded-For; 0 = use the socket address (server only)
TRUSTED_PROXY_HOPS=
