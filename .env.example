# Backend adapter: "appwrite" (default), "memory" (in-process, for development; no Appwrite variables needed) or "postgres" (server only)
BACKEND=
# Appwrite endpoint URL (public; BACKEND=appwrite)
VITE_APPWRITE_ENDPOINT=
# Appwrite project ID (public; BACKEND=appwrite)
VITE_APPWRITE_PROJECT_ID=
# Appwrite database ID (public; BACKEND=appwrite); "app" matches appwrite.json
VITE_APPWRITE_DATABASE_ID=
# "true" keeps unverified users on /verify-email until they verify; they can still sign in (public)
VITE_REQUIRE_EMAIL_VERIFICATION=
# Appwrite server API key (secret, server only; BACKEND=appwrite)
APPWRITE_API_KEY=
# Public base URL of this app; https names the session cookie __Host-app_session (server only)
APP_URL=
# Number of reverse proxies in front of the app that append to X-Forwarded-For; 0 = use the socket address (server only)
TRUSTED_PROXY_HOPS=
# Postgres connection URL (secret, server only; BACKEND=postgres)
DATABASE_URL=
# Email transport: "console" (default; logs links), "smtp" or "mailgun" (server only; BACKEND=memory or postgres)
MAIL_PROVIDER=
# Sender, e.g. "App <no-reply@example.com>"; required unless MAIL_PROVIDER is console (server only)
MAIL_FROM=
# SMTP server host (server only; MAIL_PROVIDER=smtp)
SMTP_HOST=
# SMTP server port (server only; MAIL_PROVIDER=smtp)
SMTP_PORT=
# SMTP username; leave blank for no authentication (secret, server only; MAIL_PROVIDER=smtp)
SMTP_USER=
# SMTP password (secret, server only; MAIL_PROVIDER=smtp)
SMTP_PASS=
# "true" for implicit TLS; defaults to true only on port 465 (server only; MAIL_PROVIDER=smtp)
SMTP_SECURE=
# Mailgun API key (secret, server only; MAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
# Mailgun sending domain (server only; MAIL_PROVIDER=mailgun)
MAILGUN_DOMAIN=
# Mailgun region: "us" (default) or "eu" (server only; MAIL_PROVIDER=mailgun)
MAILGUN_REGION=
