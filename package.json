{
	"name": "my-tanstack-app",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"format": "biome format",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"knip": "knip",
		"appwrite:types": "appwrite types --config-file appwrite.json --language ts --force src/server/adapters/appwrite/generated && mv src/server/adapters/appwrite/generated/appwrite.d.ts src/server/adapters/appwrite/generated/appwrite.ts",
		"appwrite:pull": "appwrite pull tables --force --config-file appwrite.json",
		"appwrite:push": "appwrite push tables --config-file appwrite.json",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"check:js": "node scripts/check-initial-js.ts",
		"lighthouse": "node scripts/assert-port-free.ts 3011 && lhci autorun",
		"verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm build && pnpm check:js && pnpm lighthouse"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-query-devtools": "5.104.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"appwrite": "29.1.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "26.5.11",
		"lucide-react": "^1.62.0",
		"nitro": "3.0.260610-beta",
		"node-appwrite": "31.0.0",
		"nodemailer": "10.3.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-i18next": "17.1.9",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.1.18",
		"tanstack-query-typed": "0.2.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@lhci/cli": "^0.15.1",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/router-cli": "^1.132.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^22.10.2",
		"@types/nodemailer": "8.0.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"appwrite-cli": "28.9.0",
		"jsdom": "^30.1.3",
		"knip": "^6.43.0",
		"lefthook": "^2.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.5",
		"vitest-axe": "^0.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"license": "MIT"
}
